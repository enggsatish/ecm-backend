<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecm</groupId>
        <artifactId>ecm-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ecm-gateway</artifactId>
    <name>ECM Gateway</name>
    <description>
        API Gateway — single entry point for all ECM frontend traffic.
        JWT validation, rate limiting, circuit breakers (via YAML), correlation IDs,
        security headers, structured access logging. Port 8080.

        IMPORTANT: Uses Spring WebFlux (reactive).
        Do NOT add spring-boot-starter-web — it conflicts with WebFlux.
        Do NOT add ecm-common — it pulls in JPA + MVC which break WebFlux.
        Do NOT add spring-boot-starter-data-jpa — gateway has no database.
    </description>

    <dependencies>

        <!-- ── Gateway (WebFlux-based) ──────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- ── JWT validation ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ── Redis — reactive driver for rate limiting ────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- ── Circuit breaker — REACTOR variant required for WebFlux ───── -->
        <!-- This provides SpringCloudCircuitBreakerFilterFactory bean.       -->
        <!-- The non-reactor variant (without -reactor-) does NOT register    -->
        <!-- this bean and causes "required bean not found" at startup.       -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>

        <!-- ── Actuator ─────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── Testing ──────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
  ═══════════════════════════════════════════════════════════════════════════════
  ecm-gateway/pom.xml — Sprint I OTEL additions

  Gateway cannot depend on ecm-common (WebFlux + JPA conflict).
  It needs the same tracing bridge + OTLP exporter PLUS the Reactor
  context-propagation library (critical for WebFlux trace continuity).
  ═══════════════════════════════════════════════════════════════════════════════
-->

        <!-- ── Micrometer Tracing Bridge ────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!-- ── OTLP Exporter ────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Reactor Context Propagation ─────────────────────────────────────────── -->
        <!--
          CRITICAL for WebFlux/Reactor-based services (ecm-gateway only).

          Without this, OTEL trace context is lost when Reactor switches threads
          (e.g., subscribeOn, flatMap, etc.). This library teaches Reactor to
          carry the OTEL context (and MDC) across thread boundaries automatically.

          Spring Boot 3.2+ auto-configures this when it's on the classpath.
          You just need to declare the dependency — no code changes required.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <!-- version managed by Spring Boot BOM (typically 1.1.x) -->
        </dependency>

        <!-- ── Micrometer Prometheus Registry ──────────────────────────────────────── -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>