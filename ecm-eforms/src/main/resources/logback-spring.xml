<?xml version="1.0" encoding="UTF-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════════════
  logback-spring.xml — Sprint I OTEL update
  Location: src/main/resources/logback-spring.xml (in EACH service module)

  Changes from pre-OTEL version:
    1. Console pattern now includes [traceId,spanId] from MDC
       These are populated automatically by Micrometer Tracing / OTEL bridge
       when micrometer-tracing-bridge-otel is on the classpath.

    2. correlationId added to console and JSON output.

    3. JSON encoder (logstash-logback-encoder) now outputs traceId, spanId,
       correlationId as top-level fields — enables ELK/OpenSearch log correlation.

  NOTE: The %X{traceId} and %X{spanId} placeholders will render as empty strings
  during startup before OTEL is initialised — this is normal.
  ══════════════════════════════════════════════════════════════════════════════
-->
<configuration>

    <!-- ── Properties ─────────────────────────────────────────────────────── -->
    <springProperty name="appName" source="spring.application.name" defaultValue="ecm-service"/>

    <!-- ── Console Appender ───────────────────────────────────────────────── -->
    <!--
      Pattern breakdown:
        %d{...}           timestamp
        [%thread]         thread name
        %-5level          log level (padded)
        [%X{traceId}]     OTEL trace ID  ← NEW: injected by Micrometer Tracing
        [%X{spanId}]      OTEL span ID   ← NEW
        [%X{correlationId}] X-Request-ID  ← from RequestMdcFilter
        %logger{36}       logger class (abbreviated to 36 chars)
        %msg%n            message + newline
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId},%X{spanId}] [%X{correlationId}] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ── JSON Appender (for structured logging / OpenSearch ingestion) ──── -->
    <!--
      Requires net.logstash.logback:logstash-logback-encoder on the classpath.
      Add to ecm-common pom if not already present:
        <dependency>
          <groupId>net.logstash.logback</groupId>
          <artifactId>logstash-logback-encoder</artifactId>
          <version>7.4</version>
        </dependency>

      Writes each log line as a single JSON object — parse-friendly for ELK/OS.
      traceId and spanId are included as top-level JSON fields so you can
      correlate logs with traces by searching traceId in both Jaeger and OpenSearch.
    -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC keys as top-level JSON fields -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>requestUri</includeMdcKeyName>
            <includeMdcKeyName>requestMethod</includeMdcKeyName>
            <includeMdcKeyName>clientIp</includeMdcKeyName>
            <!-- Add service name to every log line -->
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <!-- ── Profile-based appender selection ───────────────────────────────── -->
    <!--
      local profile → readable console output (plain text)
      azure profile → JSON output (for log aggregation in Azure Monitor / ELK)
    -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <!-- Reduce noise from framework packages -->
        <logger name="org.springframework.security"       level="WARN"/>
        <logger name="org.springframework.web"            level="WARN"/>
        <logger name="org.hibernate"                      level="WARN"/>
        <logger name="io.opentelemetry"                   level="WARN"/>
        <logger name="io.micrometer"                      level="WARN"/>
        <logger name="com.zaxxer.hikari"                  level="WARN"/>
        <logger name="org.flywaydb"                       level="INFO"/>
        <!-- ECM services at DEBUG for local development -->
        <logger name="com.ecm"                            level="DEBUG"/>
    </springProfile>

    <springProfile name="azure">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="org.springframework.security"       level="WARN"/>
        <logger name="io.opentelemetry"                   level="WARN"/>
        <logger name="com.ecm"                            level="INFO"/>
    </springProfile>

    <!-- ── Default (no profile active) ───────────────────────────────────── -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.ecm"                            level="DEBUG"/>
    </springProfile>

</configuration>