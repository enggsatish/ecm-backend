# ECM E2E Test Configuration
# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real credentials.

# ── Application URL ──────────────────────────────────────────────
ECM_BASE_URL=http://localhost:3000

# ── Test User Accounts (Okta credentials) ────────────────────────
# Each role needs a separate Okta user account.
# These are used to automate the Okta login flow.

ADMIN_USERNAME=ecm.admin@dev.local
ADMIN_PASSWORD=password!2

SUPERADMIN_USERNAME=ecm.superadmin@dev.local
SUPERADMIN_PASSWORD=password!2

REVIEWER_USERNAME=ecm.reviewer@dev.local
REVIEWER_PASSWORD=password!2

BACKOFFICE_USERNAME=ecm.backoffice@dev.local
BACKOFFICE_PASSWORD=password!2

# ── Optional ─────────────────────────────────────────────────────
# Set to 'true' to run tests with browser visible
HEADED=false

# Okta login page URL pattern (for detecting the login redirect)
OKTA_LOGIN_DOMAIN=integrator-3023444.okta.com
